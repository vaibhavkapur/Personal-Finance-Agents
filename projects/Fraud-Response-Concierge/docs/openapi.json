  "components": {
    "schemas": {
      "Affected": {
        "properties": {
          "expected_case_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Case Version"
          },
          "instrument_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 1,
            "title": "Instrument Refs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_case_version",
          "instrument_refs"
        ],
        "title": "Affected"
      },
      "Approval": {
        "properties": {
          "expected_case_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Case Version"
          },
          "action_payload_hash": {
            "type": "string",
            "title": "Action Payload Hash"
          },
          "approval_challenge_id": {
            "type": "string",
            "title": "Approval Challenge Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_case_version",
          "action_payload_hash",
          "approval_challenge_id"
        ],
        "title": "Approval"
      },
      "Chat": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "Chat"
      },
      "ClockAdvance": {
        "properties": {
          "minutes": {
            "type": "integer",
            "maximum": 43200.0,
            "minimum": 1.0,
            "title": "Minutes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "minutes"
        ],
        "title": "ClockAdvance"
      },
      "Confirmation": {
