  "components": {
    "schemas": {
      "AddDocument": {
        "properties": {
          "expected_case_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Case Version"
          },
          "kind": {
            "type": "string",
            "enum": [
              "bank_statement",
              "insurance_policy",
              "retirement_statement",
              "death_certificate",
              "letters_of_authority",
              "certified_authority",
              "retirement_claim_form"
            ],
            "title": "Kind"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "content": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30000
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_case_version",
          "kind"
        ],
        "title": "AddDocument"
      },
      "Advance": {
        "properties": {
          "seconds": {
            "type": "integer",
            "maximum": 63072000.0,
            "minimum": 1.0,
            "title": "Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "seconds"
        ],
        "title": "Advance"
      },
      "Approve": {
        "properties": {
          "expected_case_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Case Version"
          },
          "action_payload_hash": {
            "type": "string",
            "title": "Action Payload Hash"
          },
          "approval_challenge_id": {
            "type": "string",
            "title": "Approval Challenge Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_case_version",
          "action_payload_hash",
          "approval_challenge_id"
        ],
        "title": "Approve"
      },
      "CreateCase": {
        "properties": {
          "customer_id": {
            "type": "string",
            "const": "cus_demo_11",
            "title": "Customer Id",
            "default": "cus_demo_11"
          },
          "decedent_record_id": {
            "type": "string",
            "const": "syn_evelyn_morgan",
            "title": "Decedent Record Id",
            "default": "syn_evelyn_morgan"
          },
          "jurisdiction_profile": {
            "type": "string",
            "const": "US_CA_MOCK",
            "title": "Jurisdiction Profile",
            "default": "US_CA_MOCK"
          },
          "claimed_role": {
            "type": "string",
            "const": "personal_representative",
            "title": "Claimed Role",
            "default": "personal_representative"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CreateCase"
      },
      "Draft": {
        "properties": {
          "expected_case_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Case Version"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_case_version",
          "idempotency_key"
        ],
        "title": "Draft"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "enum": [
              "alex",
              "other"
            ],
            "title": "Username",
            "default": "alex"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password"
        ],
        "title": "Login"
      },
      "Scenario": {
        "properties": {
          "expected_case_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Case Version"
          },
          "scenario": {
            "type": "string",
            "enum": [
              "normal",
              "timeout_after_acceptance",
              "delayed",
              "declined",
              "no_match",
              "malformed",
              "wrong_destination"
            ],
            "title": "Scenario"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_case_version",
          "scenario"
        ],
        "title": "Scenario"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Version": {
        "properties": {
          "expected_case_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Case Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_case_version"
        ],
        "title": "Version"
      }
    }
  }
}
