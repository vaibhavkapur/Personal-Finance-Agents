  "components": {
    "schemas": {
      "AgentMessage": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "tool_budget": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Tool Budget",
            "default": 4
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AgentMessage"
      },
      "Approval": {
        "properties": {
          "expected_case_version": {
            "type": "integer",
            "title": "Expected Case Version"
          },
          "action_payload_hash": {
            "type": "string",
            "title": "Action Payload Hash"
          },
          "approval_challenge_id": {
            "type": "string",
            "title": "Approval Challenge Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_case_version",
          "action_payload_hash",
          "approval_challenge_id"
        ],
        "title": "Approval"
      },
      "Confirmation": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          },
          "category": {
            "type": "string",
            "enum": [
              "income",
              "transfer",
              "loan",
              "other"
            ],
            "title": "Category"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transaction_id",
          "category"
        ],
        "title": "Confirmation"
      },
      "Confirmations": {
        "properties": {
          "confirmations": {
            "items": {
              "$ref": "#/components/schemas/Confirmation"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Confirmations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirmations"
        ],
        "title": "Confirmations"
      },
      "Draft": {
        "properties": {
          "proposal_id": {
            "type": "string",
            "title": "Proposal Id"
          },
          "simulation_mode": {
            "type": "string",
            "enum": [
              "normal",
              "delay",
              "timeout",
              "decline",
              "malformed"
            ],
            "title": "Simulation Mode",
            "default": "normal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "proposal_id"
        ],
        "title": "Draft"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewCase": {
        "properties": {
          "customer_id": {
            "type": "string",
            "title": "Customer Id",
            "default": "cus_demo_12"
          },
          "policy_id": {
            "type": "string",
            "title": "Policy Id",
            "default": "reserve_policy_demo_1"
          },
          "requested_payout_minor": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 1.0,
            "title": "Requested Payout Minor",
            "default": 300000
          },
          "currency": {
            "type": "string",
            "const": "USD",
            "title": "Currency",
            "default": "USD"
          },
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "title": "Period",
            "default": "2026-10"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "NewCase"
      },
      "Policy": {
        "properties": {
          "provisional_tax_fraction_decimal": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Provisional Tax Fraction Decimal"
          },
          "emergency_floor_minor": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Emergency Floor Minor"
          },
          "planning_horizon_days": {
            "type": "integer",
            "maximum": 365.0,
            "minimum": 1.0,
            "title": "Planning Horizon Days"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provisional_tax_fraction_decimal",
          "emergency_floor_minor",
          "planning_horizon_days"
        ],
        "title": "Policy"
      },
      "PolicyApproval": {
        "properties": {
          "action_payload_hash": {
            "type": "string",
            "title": "Action Payload Hash"
          },
          "approval_challenge_id": {
            "type": "string",
            "title": "Approval Challenge Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action_payload_hash",
          "approval_challenge_id"
        ],
        "title": "PolicyApproval"
      },
      "Simulation": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "advance",
              "settle",
              "return",
              "late_receipt",
              "ambiguous_receipt",
              "bill_change",
              "late_scenario"
            ],
            "title": "Kind"
          },
          "seconds": {
            "type": "integer",
            "maximum": 2678400.0,
            "minimum": 0.0,
            "title": "Seconds",
            "default": 3600
          },
          "transfer_id": {
            "type": "string",
            "title": "Transfer Id",
            "default": ""
          },
          "amount_minor": {
            "type": "integer",
            "maximum": 100000000.0,
